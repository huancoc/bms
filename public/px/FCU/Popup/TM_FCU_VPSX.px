<?xml version="1.0" encoding="UTF-8"?>
<!-- Niagara Presentation XML -->
<px version="1.0" media="workbench:WbPxMedia">
<import>
  <module name="baja"/>
  <module name="bajaui"/>
  <module name="converters"/>
  <module name="gx"/>
  <module name="kitPx"/>
</import>
<layers>
  <layer name="newLayer" status="normal"/>
  <layer name="BG_Lock" status="locked"/>
</layers>
<content>
<CanvasPane viewSize="1400.0,550.0" scale="fit" background="image( source(null) )">

  <Rect fill="white" stroke="black" geom="0.0,0.0,1400.0,550.0">
    <LayerTag name="LayerTag" layerName="BG_Lock"/>
  </Rect>

  <BoundLabel layout="0.0,0.0,1400.0,40.0" text="  FCU" font="24.0pt Tahoma" foreground="white" background="linearGradient( angle(90.0) stop(0.0% black) stop(100.0% #505050) )" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="205.0,125.0,130.0,105.0" image="file:^px/kitPxGraphics/Ductwork/Duct_Horz_End_Left.png">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="325.0,125.0,175.0,105.0" image="file:^px/kitPxGraphics/Ductwork/Duct_Horz_Short.png">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="575.0,125.0,175.0,105.0" image="file:^px/kitPxGraphics/Ductwork/Duct_Horz_Short.png">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="455.0,125.0,175.0,105.0">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
    <ValueBinding ord="station:|slot:/Drivers/DO1">
      <IBooleanToSimple name="image">
        <Image name="trueValue" value="file:^px/kitPxGraphics/Filters/Filter_Single_Dp/Filter_Single_DP_4.png"/>
        <Image name="falseValue" value="file:^px/kitPxGraphics/Filters/Filter_Single_Dp/Filter_Single_DP_0.png"/>
