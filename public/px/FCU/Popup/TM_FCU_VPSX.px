  <BoundLabel layout="955.0,125.0,130.0,105.0" image="file:^px/kitPxGraphics/Ductwork/Duct_Horz_End_Right.png">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="850.0,125.0,130.0,105.0" image="file:^px/kitPxGraphics/Sensors/sensor_duct_pressurealrm_top.png">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
