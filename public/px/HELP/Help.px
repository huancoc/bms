  <Label layout="45.0,635.0,89.99999999999997,30.0" text="L&#x1ecb;ch t&#x1eaf;t" background="#ccff0000"/>

  <ImageButton layout="1040.0,340.0,800.0,580.0" image="file:^Image/SCH_Help.PNG" font="bold 20.0pt SansSerif" foreground="white" halign="left" buttonStyle="none">
    <WsAnnotation name="wsAnnotation" value="6,6,8"/>
  </ImageButton>

  <BoundLabel layout="240.0,100.0,150.0,30.0">
