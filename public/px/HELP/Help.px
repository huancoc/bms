    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="90.0,685.0,320.0,30.0" text=" C&#xf3; l&#x1ed7;i Trip - C&#x1ea7;n ki&#x1ec3;m tra t&#x1ee7; l&#x1ef1;c t&#x1b0;&#x1a1;ng &#x1ee9;ng" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
