  <BoundLabel layout="870.0,100.0,150.0,30.0">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
    <BoundLabelBinding hyperlink="file:^px/HELP/Help.px"/>
  </BoundLabel>

  <PxInclude layout="560.0,180.0,210.0,70.0" ord="file:^px/Panel/Help/PanelVSD.px"/>

  <BoundLabel layout="20.0,180.0,209.9999999999999,20.0" text="&#x110;i&#x1ec1;u khi&#x1ec3;n On/Off" font="14.0pt Tahoma" foreground="black" background="#e0e0e0" border="2.0 groove black">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,210.0,470.0,20.0" text="  &#x1ea4;n On &#x111;&#x1ec3; b&#x1ead;t, Off &#x111;&#x1ec3; t&#x1eaf;t c&#x1b0;&#x1ee1;ng b&#x1ee9;c b&#x1eb1;ng BMS" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,235.0,470.0,20.0" text="  &#x1ea4;n Auto &#x111;&#x1ec3; thi&#x1ebf;t b&#x1ecb; ch&#x1ea1;y theo l&#x1ecb;ch ho&#x1eb7;c l&#x1ead;p tr&#xec;nh t&#x1ef1; &#x111;&#x1ed9;ng" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,260.0,759.9999999999999,20.0" text="  N&#xfa;t Auto c&#xf3; n&#x1ec1;n m&#xe0;u t&#xed;m l&#xe0; &#x111;ang b&#x1ead;t c&#x1b0;&#x1ee1;ng b&#x1ee9;c, trong su&#x1ed1;t m&#xe0;u tr&#x1eaf;ng l&#xe0; &#x111;ang &#x1edf; ch&#x1ebf; &#x111;&#x1ed9; t&#x1ef1; &#x111;&#x1ed9;ng / l&#x1ecb;ch" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,290.0,209.9999999999999,20.0" text="&#x110;i&#x1ec1;u khi&#x1ec3;n bi&#x1ebf;n t&#x1ea7;n" font="14.0pt Tahoma" foreground="black" background="#e0e0e0" border="2.0 groove black">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,320.0,649.9999999999999,20.0" text=" Click chu&#x1ed9;t v&#xe0;o &#xf4; gi&#xe1; tr&#x1ecb; Hz nh&#x1ead;p gi&#xe1; tr&#x1ecb; c&#x1ea7;n ch&#x1ea1;y (25-50Hz)" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,420.0,759.9999999999999,20.0" text="  Khuy&#x1ebf;n c&#xe1;o: Ch&#x1ec9; n&#xea;n c&#xe0;i &#x111;&#x1eb7;t bi&#x1ebf;n t&#x1ea7;n &#x1edf; m&#x1ee9;c 50-100 (%) &#x111;&#x1ec3; &#x111;&#x1ea3;m b&#x1ea3;o &#x111;&#x1ed9; b&#x1ec1;n cho thi&#x1ebf;t b&#x1ecb; qu&#x1ea1;t b&#x1a1;m d&#xf9;ng bi&#x1ebf;n t&#x1ea7;n" font="14.0pt Tahoma" foreground="white" background="#80ff0000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,370.0,650.0,20.0" text="  Khi b&#x1ead;t/ t&#x1eaf;t c&#x1b0;&#x1ee1;ng b&#x1ee9;c, n&#xfa;t b&#x1ead;t t&#x1eaf;t s&#x1ebd; hi&#x1ec3;n th&#x1ecb; m&#xe0;u t&#xed;m t&#x1b0;&#x1a1;ng t&#x1ef1; n&#xfa;t Auto" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="20.0,395.0,650.0,20.0" text=" 3. Khi c&#x1ea7;n ch&#x1ea1;y t&#x1ef1; &#x111;&#x1ed9;ng theo l&#x1ecb;ch ho&#x1eb7;c ch&#x1b0;&#x1a1;ng tr&#xec;nh c&#xe0;i &#x111;&#x1eb7;t th&#xec; click chu&#x1ed9;t ph&#x1ea3;i ch&#x1ecd;n Auto n&#x1ec1;n ch&#x1eef; trong su&#x1ed1;t nh&#x1b0; h&#xec;nh l&#xe0; ok" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="25.0,450.0,209.9999999999999,20.0" text="  C&#xe0;i &#x111;&#x1eb7;t L&#x1ecb;ch b&#x1ead;t t&#x1eaf;t" font="14.0pt Tahoma" foreground="black" background="#e0e0e0" border="2.0 groove black">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="150.0,490.0,519.9999999999999,20.0" text="  Nh&#x1ea5;n v&#xe0;o C&#xe0;i &#x111;&#x1eb7;t l&#x1ecb;ch &#x111;&#x1ec3; c&#xe0;i l&#x1ecb;ch" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="150.0,515.0,519.9999999999999,20.0" text="  Event Stat: Th&#x1edd;i gian b&#x1eaf;t &#x111;&#x1ea7;u" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="150.0,540.0,519.9999999999999,20.0" text="  Event Finish: Th&#x1edd;i gian k&#x1ebf;t th&#xfa;c" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="150.0,565.0,519.9999999999999,20.0" text="True: &#x111;ang &#x111;&#x1b0;&#x1ee3;c b&#x1ead;t trong kho&#x1ea3;ng TRUE n&#xe0;y, False s&#x1ebd; t&#x1eaf;t" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
  </BoundLabel>

  <BoundLabel layout="150.0,615.0,519.9999999999999,20.0" text="  L&#x1ecb;ch &#x111;ang b&#x1ead;t" font="14.0pt Tahoma" foreground="white" background="#4d000000" halign="left">
