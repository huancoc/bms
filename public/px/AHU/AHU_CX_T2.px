  <BoundLabel layout="5.0,185.0,190.0,40.0" text=" Chi&#x1ebf;t xu&#x1ea5;t t&#x1ea7;ng 2" font="20.0pt Tahoma" foreground="black" background="lime" halign="left" border="2.0 groove black">
