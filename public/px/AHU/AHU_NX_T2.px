      <IBooleanToSimple name="image">
        <Image name="trueValue" value="file:^px/Images/Icon/FCU_On.png"/>
        <Image name="falseValue" value="file:^px/Images/Icon/FCU_Off.png"/>
      </IBooleanToSimple>
    </ValueBinding>
    <PopupBinding ord="file:^px/FCU/Popup/FCU_01.px" title="FCU-01" size="1000.0,400.0"/>
  </Picture>

  <Picture layout="1515.0,460.0,89.99999999999977,40.0" scale="fitRatio">
