    <WsAnnotation name="wsAnnotation" value="2,2,8"/>
    <PopupBinding ord="file:^px/FCU/Popup/FCU_03.px" title="FCU3" size="1000.0,400.0"/>
  </BoundLabel>

  <Picture layout="1250.0,240.0,89.99999999999977,40.0" scale="fitRatio">
